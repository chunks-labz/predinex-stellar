{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".."
  },
  "include": ["src/**/*.ts", "../oracle/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
