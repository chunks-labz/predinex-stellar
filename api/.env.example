# Predinex API Environment Configuration
# Copy this file to .env and fill in the values. Never commit the real .env.

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# HMAC secret used to sign and verify payloads (AuthValidator).
# The API refuses to start when this is missing or blank; there is no default.
# Generate a fresh value per deployment, for example:
#   openssl rand -hex 32
AUTH_SECRET=

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# HTTP port (default 3001)
PORT=3001

# Comma-separated API keys per role, sent by clients in the x-api-key header.
ADMIN_API_KEYS=
OFFICER_API_KEYS=
ASSESSOR_API_KEYS=
