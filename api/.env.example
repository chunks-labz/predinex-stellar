# Predinex API Environment Configuration
# Copy this file to .env and fill in the values. Never commit the real .env.

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# HMAC secret used to sign and verify payloads (AuthValidator).
# The API refuses to start when this is missing or blank; there is no default.
# Generate a fresh value per deployment, for example:
#   openssl rand -hex 32
AUTH_SECRET=

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# HTTP port (default 3001)
PORT=3001

# Comma-separated API keys per role, sent by clients in the x-api-key header.
ADMIN_API_KEYS=
OFFICER_API_KEYS=
ASSESSOR_API_KEYS=

# Rate limiting (see #1423). Limits apply per registered API key (x-api-key
# listed above) or, for everyone else, per client IP. Over-limit requests get
# HTTP 429 with a Retry-After header. Invalid values fall back to the default.
# Window length in milliseconds (default 60000).
RATE_LIMIT_WINDOW_MS=60000
# Requests per window for general endpoints (default 100).
RATE_LIMIT_MAX_REQUESTS=100
# Requests per window for mutating / emergency endpoints (default 20).
RATE_LIMIT_STRICT_MAX_REQUESTS=20

# OpenTelemetry tracing (see #1426). Disabled by default; nothing is exported
# unless this is "true". Spans go to an OTLP/HTTP collector, selected with the
# standard OTEL_EXPORTER_OTLP_ENDPOINT (e.g. http://localhost:4318) variable.
OTEL_TRACING_ENABLED=false
# Service name reported on spans (default predinex-api).
OTEL_SERVICE_NAME=predinex-api
