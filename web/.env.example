# Predinex Web Application Environment Configuration
# Copy this file to .env.local and update the values as needed
#
# Every variable read by the app under web/ is documented here. CI enforces this
# two ways (see web/tests/lib/env-doc.test.ts):
#   1. a variable referenced in web/ source must appear in this file, and
#   2. every client-safe variable in web/app/lib/env-boundary.ts must appear here.
# If you add a new `process.env.X` read, add it below or the check fails.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time and is therefore public. Never put a secret behind a NEXT_PUBLIC_ prefix.

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# Network selection - must be either 'mainnet' or 'testnet'
# This determines which network the app connects to
NEXT_PUBLIC_NETWORK=testnet

# Deployed Soroban contract ID (C... strkey) - the canonical contract address.
# Read by runtime-config.ts and drives BOTH `contract` and `soroban.contractId`,
# so the Soroban adapters, activity feed and dispute history all agree.
# When unset, contract coordinates fall back to the built-in analytics defaults
# (which are empty unless this same variable is set) and contract calls fail
# gracefully at the RPC layer. There is no startup check for this — set it.
# Testnet example: CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
NEXT_PUBLIC_SOROBAN_CONTRACT_ID=

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# Vercel KV (Upstash Redis) for persistent push-subscription storage.
# Required for push notifications to survive serverless cold starts.
# Create a KV store in the Vercel dashboard to get these values.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Application URL - used for WalletConnect metadata and OG images
# Defaults to https://predinex.app if not set
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Build version reported in the client runtime config and surfaced in the UI.
# Falls back to 'unknown' when unset.
NEXT_PUBLIC_APP_VERSION=

# Display currency for bet amounts, incentives and balances.
# Leave both unset to use the Stellar defaults (XLM / Stellar Lumens).
NEXT_PUBLIC_TOKEN_SYMBOL=
NEXT_PUBLIC_TOKEN_NAME=

# WalletConnect Cloud Project ID
# Required for WalletConnect integration
# Get yours at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID

# Web Push VAPID public key used by PushManager.subscribe.
# Generate a VAPID keypair for your deployment and keep the private key server-side only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-side Web Push delivery workers should use matching private values.
# These are intentionally not NEXT_PUBLIC_* and must never be imported by client code.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Soroban RPC URL - overrides the default RPC endpoint for the selected network
# Defaults: mainnet=https://mainnet.stellar.validationcloud.io/v1/soroban/rpc, testnet=https://soroban-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Origin allowed to receive postMessage payloads from the pool embed widget
# (e.g. https://partner.example). Pins every embed to a single host page.
# When unset, the widget derives the target origin from document.referrer and
# drops the message entirely if no origin can be determined — it never
# broadcasts pool or bet data with a '*' target origin.
NEXT_PUBLIC_PREDINEX_ALLOWED_EMBED_ORIGIN=

# Bridge Contract ID - the deployed cross-chain bridge contract on Stellar
# (C... strkey) that settles pool mirrors on target chains. Required
# only when creating a cross-chain pool mirror (#928).
NEXT_PUBLIC_SOROBAN_BRIDGE_CONTRACT_ID=

# Default oracle provider address pre-filled in the oracle registration form.
# Must be a valid Stellar account address (G... strkey, 56 characters).
# Testnet example: GAAZI4TCR3TY5OJHCTJC2A4QSY6CJWJH5IAJTGKIN2ER7LBNVKOCCWN
# When unset the form placeholder is left empty.
NEXT_PUBLIC_DEFAULT_ORACLE_ADDRESS=

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# All flags are opt-in: only the exact string 'true' enables them. Anything
# else (including leaving them unset) means off.

# Show a placeholder panel in the oracle management area.
# Set to 'true' while the management UI is still being built.
NEXT_PUBLIC_ENABLE_ORACLE_MANAGEMENT_PLACEHOLDER=false

# =============================================================================
# MOCK / FIXTURE DATA — NEVER ENABLE IN PRODUCTION
# =============================================================================
# These two switches both swap real data for fake data, but they cover
# different surfaces. Both ship disabled and both must stay disabled on any
# public deployment: a production instance serving synthetic data is worse than
# one serving none, because it looks healthy.

# Serve seeded, deterministic activity rows instead of querying the chain.
# Affects the activity feed and pool activity. See app/lib/adapters/activity.ts.
NEXT_PUBLIC_ACTIVITY_FIXTURES=false

# Show mock dispute data when no real disputes exist.
# Set to 'false' or leave unset to show unavailable state instead.
NEXT_PUBLIC_ENABLE_DISPUTE_MOCK_DATA=false

# =============================================================================
# TELEMETRY
# =============================================================================

# Set to 'true' to disable all wallet telemetry. Required for deployments that
# must not phone home. See app/lib/wallet-telemetry.ts.
NEXT_PUBLIC_DISABLE_TELEMETRY=false

# =============================================================================
# DEPRECATED — CONTRACT IDENTIFIERS
# =============================================================================
# #1308 — a Soroban contract is identified by a single C... strkey, so
# NEXT_PUBLIC_SOROBAN_CONTRACT_ID is now the only supported way to point the app
# at a contract. The two variables below are still read so existing deployments
# do not silently fall back to a default contract, but new setups must not use
# them. They are scheduled for removal.

# DEPRECATED — deprecated alias for NEXT_PUBLIC_SOROBAN_CONTRACT_ID.
# Only consulted when NEXT_PUBLIC_SOROBAN_CONTRACT_ID is unset.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# DEPRECATED — legacy contract name. Only used by the Stacks-shaped read APIs
# that build /{address}/{name}/events URLs. No longer required alongside the
# contract id; set it only if you still run those endpoints.
NEXT_PUBLIC_CONTRACT_NAME=

# =============================================================================
# WEBHOOKS
# =============================================================================

# Destination for pool event notifications.
NEXT_PUBLIC_WEBHOOK_URL=
NEXT_PUBLIC_WEBHOOK_ENABLED=false

# HMAC-SHA256 signing key for outbound webhooks.
# SERVER-ONLY (#1286): do not prefix this with NEXT_PUBLIC_. A NEXT_PUBLIC_ value
# is inlined into the browser bundle, which would let anyone forge signed
# deliveries. Read only by app/api/webhooks/notify/route.ts.
WEBHOOK_SECRET=

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Enable debug logging in development
# Set to 'true' to see detailed logs
DEBUG=false
